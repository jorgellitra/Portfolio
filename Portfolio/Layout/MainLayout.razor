@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

@Body

@code {

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    // Blazor keeps the scroll position between pages; reset it on route changes
    // (in-page #anchors are handled by site.js and never reach the router).
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!e.Location.Contains('#'))
        {
            await JS.InvokeVoidAsync("portfolio.scrollTop");
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

}
