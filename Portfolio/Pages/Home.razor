@page "/"
@using Portfolio.Classes

<PageTitle>@PortfolioData.Identity.Name | @PortfolioData.Identity.JobTitle</PageTitle>

<div class="page">

    <SiteNav/>

    <header class="hero">
        <div class="hero-content">
            <h6 class="hero-kicker">@PortfolioData.Identity.JobTitle</h6>
            <h1>@PortfolioData.Identity.Headline</h1>
            <p class="text-muted hero-tagline">@PortfolioData.Identity.Subheadline</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="work">View all projects</a>
                <a class="btn btn-secondary" href="@PortfolioData.Identity.CvPath" target="_blank">Download CV</a>
                <span class="hero-socials">
                    @foreach (var social in PortfolioData.Identity.Socials)
                    {
                        <a href="@social.Url" target="_blank" title="@social.Label"><i class="@social.Icon"></i></a>
                    }
                </span>
            </div>
        </div>
        <img class="hero-photo" src="@PortfolioData.Identity.PhotoPath" alt="@PortfolioData.Identity.Name"/>
    </header>

    <div class="skills">
        @foreach (var skill in PortfolioData.Skills)
        {
            <span class="tag tag-neutral">@skill</span>
        }
    </div>

    <section id="projects" class="section">
        <h6 class="section-kicker">Featured work</h6>
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:24px;flex-wrap:wrap;">
            <h2 style="margin:0;">Projects</h2>
            <a href="work" style="font-size:14px;text-decoration:none;">All projects →</a>
        </div>
        <div class="projects-grid" style="--project-cols:@PortfolioData.HomeGridColumns">
            @foreach (var project in PortfolioData.Projects)
            {
                <ProjectCard Project="project"/>
            }
        </div>
    </section>

    <section id="experience" class="section">
        <h2 style="margin-bottom:20px;">Experience</h2>
        @foreach (var item in PortfolioData.Experience)
        {
            <TimelineRow Item="item"/>
        }
        <h3 style="margin:32px 0 12px;">Education</h3>
        @foreach (var item in PortfolioData.Education)
        {
            <TimelineRow Item="item"/>
        }
    </section>

    <section id="about" class="about-grid">
        <div>
            <h2 style="margin-bottom:14px;">@PortfolioData.Identity.AboutTitle</h2>
            @foreach (var paragraph in PortfolioData.Identity.AboutParagraphs)
            {
                <p class="text-muted">@paragraph</p>
            }
        </div>
        <div>
            <h6 class="section-kicker" style="margin-bottom:12px;">Get in touch</h6>
            <div class="contact-links">
                @foreach (var link in PortfolioData.Identity.ContactLinks)
                {
                    <a href="@link.Url" target="_blank"><i class="@link.Icon"></i>@link.Label</a>
                }
            </div>
        </div>
    </section>

    <SiteFooter/>

</div>
